        <mxCell id="edge_note" value="&lt;b&gt;Recommended boundary&lt;/b&gt;&lt;br&gt;CloudFront serves the private S3 origin through Origin Access Control. API paths use a CloudFront VPC origin to an internal ALB. The ALB authenticates human sessions with Cognito; approved workloads use scoped IAM/OIDC or a dedicated service authorization layer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#545B64;fontSize=11;" vertex="1" parent="edge">
          <mxGeometry x="735" y="42" width="630" height="120" as="geometry"/>
        </mxCell>

